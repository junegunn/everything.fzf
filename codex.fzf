require 'json'
require 'time'
require 'shellwords'

begin
  require 'ansi256'
rescue LoadError
  require 'bundler/inline'
  gemfile(true) do
    source 'https://rubygems.org'
    gem 'ansi256'
  end
end

ROOT = File.expand_path('~/.codex')
SESSION_GLOB = File.join(ROOT, 'sessions', '*', '*', '*', '*.jsonl')
RS = "\x0"
ZWSP = "\u200B"
HOME = Dir.home

abort "Session directory not found: #{ROOT}/sessions" unless Dir.exist?(File.join(ROOT, 'sessions'))

def truncate(text, width)
  return text if text.length <= width

  "#{text[0, width - 3]}..."
end

def clean(text)
  text.to_s.gsub(/\s+/, ' ').strip
end

def input_text(payload)
  return unless payload['type'] == 'message' && payload['role'] == 'user'

  payload.fetch('content', []).filter_map do |part|
    part['text'] if part['type'] == 'input_text'
  end.join("\n")
end

def generated_context?(text)
  text.start_with?('<environment_context>', '<permissions instructions>',
                   '<skills_instructions>', '<collaboration_mode>', '<skill>',
                   '# AGENTS.md instructions')
end

def event_time(event, path)
  Time.parse(event['timestamp'].to_s)
rescue ArgumentError
  File.mtime(path)
end

def prompt_entries_from(path)
  messages = []
  fallback = []

  File.foreach(path) do |line|
    event = JSON.parse(line)
    payload = event['payload'] || {}

    case event['type']
    when 'event_msg'
      message = payload['message']
      if payload['type'] == 'user_message' && !generated_context?(message.to_s)
        messages << { text: message, timestamp: event_time(event, path) }
      end
    when 'response_item'
      text = input_text(payload)
      if text && !text.empty? && !generated_context?(text)
        fallback << { text: text, timestamp: event_time(event, path) }
      end
    end
  rescue JSON::ParserError
    next
  end

  messages.empty? ? fallback : messages
end

def session_index
  path = File.join(ROOT, 'session_index.jsonl')
  return {} unless File.exist?(path)

  File.foreach(path).each_with_object({}) do |line, index|
    entry = JSON.parse(line)
    title = clean(entry['thread_name'])
    index[entry['id']] = title unless title.empty?
  rescue JSON::ParserError
    next
  end
end

def prompt_preview(entry, number, total)
  timestamp = entry[:timestamp].localtime.strftime('%F %a %T')
  header = "#{"##{number}/#{total}".green} #{timestamp.cyan}"
  "#{header}\n#{('▔' * header.plain.length).dim}\n#{entry[:text].to_s.italic}\n\n"
end

def prompts_with_offsets(path)
  prompts = prompt_entries_from(path).sort_by { -it[:timestamp].to_f }
  offset = 1
  prompts.each_with_index.map do |prompt, index|
    prompt.merge(offset: offset).tap do
      offset += prompt_preview(prompt, prompts.length - index, prompts.length).lines.count
    end
  end
end

def session_info(path, titles)
  meta = nil

  File.foreach(path) do |line|
    event = JSON.parse(line)
    meta = event['payload'] || {} if event['type'] == 'session_meta'
  rescue JSON::ParserError
    next
  end

  return unless meta

  id = meta['session_id'] || meta['id']
  return if id.to_s.empty?

  prompts = prompts_with_offsets(path)
  title = titles[id] || clean(prompts.first&.fetch(:text, ''))
  title = '(untitled session)' if title.empty?

  return {
    id: id,
    cwd: meta['cwd'].to_s,
    path: path,
    prompts: prompts
  }.merge(title: title)
end

def session_paths
  Dir[SESSION_GLOB]
end

def print_preview(session)
  entries = session[:prompts]
  entries.each_with_index do |entry, index|
    print prompt_preview(entry, entries.length - index, entries.length)
  end
end

if ARGV.delete('--preview')
  id = ARGV.first
  abort 'usage: codex.fzf --preview SESSION_ID [TRANSCRIPT_PATH]' unless id

  titles = session_index
  paths = ARGV[1] ? [ARGV[1]] : session_paths
  session = paths.lazy.filter_map { session_info(it, titles) }
                      .find { it[:id] == id }
  abort "Session not found: #{id}" unless session

  print_preview(session)
  exit
end

titles = session_index
transcripts = session_paths.filter_map { session_info(it, titles) }
entries = transcripts.flat_map do |session|
  session[:prompts].map { session.merge(it) }
end
abort 'No Codex prompts found' if entries.empty?

COLORS = (33..230).reject { |color| color % 36 < 7 }.freeze

# An open transcript identifies sessions selected through the resume picker.
def session_of(process)
  ids = process[:sessions]
  return ids.first if ids.one?

  pid = process[:pid]
  argv = `ps -ww -o command= -p #{pid}`
  id = argv[/\bresume\s+(?:-\S+\s+)*(\h{8}-\h{4}-\h{4}-\h{4}-\h{12})\b/, 1]
  return id if id

  children = `pgrep -P #{pid}`.split
  return if children.empty?

  command = `ps -Eww -o command= -p #{children.join(',')}`
  command[/\bCODEX_(?:THREAD|SESSION)_ID=(\S+)/, 1]
end

def open_files(fields)
  files = {}
  file = nil
  fields.each do |field|
    value = field[1..]
    case field[0]
    when 'f' then file = files[value] = {}
    when 'n' then file[:path] = value if file
    when 'a' then file[:access] = value if file
    end
  end
  files
end

def open_sessions(files, transcripts_by_path)
  files.values.filter_map do |file|
    transcripts_by_path[file[:path]] if %w[w u].include?(file[:access])
  end.uniq
end

def codex_processes(ttys)
  terminals = `ps -axco pid=,tty=,comm=`.lines.filter_map do |line|
    pid, tty, command = line.split
    [pid, tty] if File.basename(command.to_s) == 'codex'
  end.to_h
  return [] if terminals.empty?

  `lsof -nP -a -p #{terminals.keys.join(',')} -Ffan`.split(/^p/).reject(&:empty?).map do |item|
    pid, *fields = item.lines.map(&:chomp)
    files = open_files(fields)
    pane = ttys[files.dig('0', :path)]
    { pid: pid, cwd: files.dig('cwd', :path), pane: pane, files: files,
      terminal: !terminals.fetch(pid, '?').start_with?('?') }
  end
end

def start_time_of(pid)
  Time.parse(`ps -o lstart= -p #{pid}`)
rescue ArgumentError
  nil
end

def session_candidates(process, transcripts, sessions, active_ids)
  found = transcripts.select do |entry|
    entry[:cwd] == process[:cwd] && !sessions.key?(entry[:id])
  end

  # A shared backend owns the transcripts for its terminal clients.
  active = found.select { active_ids.include?(it[:id]) }
  return active unless active.empty?

  start = start_time_of(process[:pid])
  return [] unless start

  found.select { File.mtime(it[:path]) >= start }
end

panes = if ENV['TMUX']
          ttys = `tmux list-panes -a -F "\#{pane_tty} \#{session_name} \#{window_id} \#{pane_id}"`
                   .lines
                   .map { it.strip.split }
                   .group_by(&:shift)
                   .transform_values(&:flatten)

          procs = codex_processes(ttys)
          transcripts_by_path = transcripts.to_h { [it[:path], it[:id]] }
          procs.each { it[:sessions] = open_sessions(it[:files], transcripts_by_path) }
          active_ids = procs.flat_map { it[:sessions] }.uniq

          sessions = {}
          clients = procs.select { it[:pane] || it[:terminal] }
          # Reserve sessions owned by clients outside this tmux server.
          clients.reject { it[:pane] }.each do |process|
            process[:sessions].each { sessions[it] = nil }
          end
          orphans = clients.reject do |process|
            session = session_of(process)
            next false unless session

            sessions[session] ||= process[:pane]
            true
          end

          # Match unclaimed active sessions by directory, then try modification
          # times. Require a unique session and pane in either case.
          orphans.filter_map do |process|
            found = session_candidates(process, transcripts, sessions, active_ids)
            [found.first[:id], process[:pane]] if found.length == 1
          end.group_by(&:first).each do |session, list|
            sessions[session] = list.first.last if list.length == 1
          end

          sessions
        end || {}

COLUMN_HEADER = [
  'TIMESTAMP'.ljust(23),
  'PANE'.ljust(5),
  'SESSION'.ljust(8),
  'NAME'.ljust(50),
  'PROJECT'
].map(&:bold).join('  ')

color_map = Hash.new { |hash, key| hash[key] = COLORS[hash.size % COLORS.size] }

fzf_command = <<~CMD
  fzf --read0 --ansi --reverse --style full --gap --wrap word \\
      --delimiter "#{ZWSP}" --with-nth 5.. --accept-nth '{1}' \\
      --highlight-line --scheme history \\
      --border-label ' Codex sessions ' \\
      --header 'Press Ctrl-/ to toggle preview' --header-lines 1 \\
      --header-border dashed --header-lines-border inline \\
      --preview 'ruby #{__FILE__.shellescape} --preview {2} {3}' \\
      --preview-window 'hidden:wrap-word:+{4}' \\
      --bind 'ctrl-/:toggle-preview' #{ARGV.map(&:shellescape).join(' ')}
CMD

selected = IO.popen(fzf_command, 'r+') do |io|
  io.print((ZWSP * 4) + COLUMN_HEADER + RS)
  entries.sort_by { -it[:timestamp].to_f }.each do |entry|
    id = entry[:id]
    cwd = entry[:cwd]
    directory = cwd.start_with?(HOME) ? cwd.sub(HOME, '~') : cwd

    if (pane = panes[id])
      session, window, pane_id = pane
      command = "tmux switch-client -t #{session.shellescape} && " \
                "tmux select-window -t #{window} && " \
                "tmux select-pane -t #{pane_id}"
      pane_display = pane_id.ljust(5).green
    else
      codex_command = ENV.fetch('CODEX_COMMAND', 'codex')
      command = "cd #{cwd.shellescape}; exec #{codex_command} resume #{id.shellescape}"
      pane_display = '     '
    end

    color = color_map[id]
    io.print [command, id, entry[:path], entry[:offset]].map { it.to_s + ZWSP }.join
    io.puts [entry[:timestamp].localtime.strftime('%F %a %T').cyan,
             pane_display,
             id[0, 8].fg(color),
             truncate(entry[:title], 50).ljust(50).fg(color),
             directory.blue].map { it + ZWSP }.join('  ')
    entry[:text].to_s.each_line { io.print "  #{it.italic}" }
    io.print RS
  rescue Errno::EPIPE
    break
  end
  io.close_write
  io.gets
end

exec "eval #{selected.shellescape}" if selected
